generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  discordId          String?   @unique
  minecraftName      String?
  minecraftUuid      String?   @unique
  customSkinUrl      String?
  mcVerificationCode String?   @unique
  isMcVerified       Boolean   @default(false)
  role               String    @default("MEMBER")
  paraCoins          Int       @default(0)
  xp                 Int       @default(0)
  showcase           String[]  @default([])
  level              Int       @default(1)
  lastDaily          DateTime?
  createdAt          DateTime  @default(now())
  staffTitle         String?
  staffBio           String?
  staffColor         String?
  profileAccent      String?
  vipUntil           DateTime?
  profileBio         String?
  profileBanner      String?
  profileHidden      String[]  @default([])
  profileTagline     String?
  profileLinks       String[]  @default([])

  accounts        Account[]
  sessions        Session[]
  topics          Topic[]
  comments        Comment[]
  tierLists       TierList[]
  createdCards    TradingCard[]
  inventory       UserCard[]
  applications    Application[]
  modApplications ModApplication[]
  boxes           UserBox[]
  marketListings  MarketListing[]
  cosmetics       UserCosmetic[]
}

model Topic {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  category  String    @default("general")
  pinned    Boolean   @default(false)
  locked    Boolean   @default(false)
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
}

model TierList {
  id        String   @id @default(cuid())
  title     String
  data      String   @db.Text
  gameMode  String   @default("GENERAL")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Application {
  id            String   @id @default(cuid())
  minecraftName String
  age           Int
  motivation    String   @db.Text
  experience    String   @db.Text
  referral      String?
  status        String   @default("PENDING")
  reviewNote    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applicantId   String
  applicant     User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model TradingCard {
  id                String   @id @default(cuid())
  title             String
  playerId          String?
  player            Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  description       String?  @db.Text
  imageUrl          String?
  layer1Url         String?
  layer2Url         String?
  layer3Url         String?
  renderedImageUrl  String?
  customBackground  String?
  customBadges      String   @default("[]") @db.Text
  characterPosition String   @default("{\"x\":50,\"y\":50,\"scale\":100}") @db.Text
  rarity            String   @default("COMMON")
  level             String   @default("Normal")
  edition           String   @default("Standard")
  proba             Float    @default(100)
  attributes        String   @default("{}") @db.Text
  template          String   @default("classic")
  isPublished       Boolean  @default(false)
  isVariant         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  owners         UserCard[]
  motherLinks    CardVariantLink[] @relation("MotherCard")
  asVariantLinks CardVariantLink[] @relation("TargetCard")
}

model CardTemplate {
  id                String   @id @default(cuid())
  name              String
  customBackground  String?
  customBadges      String   @default("[]") @db.Text
  characterPosition String   @default("{\"x\":50,\"y\":50,\"scale\":100}") @db.Text
  level             String   @default("Normal")
  attributes        String   @default("{}") @db.Text
  createdAt         DateTime @default(now())
}

model UserCard {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingCardId String
  tradingCard   TradingCard @relation(fields: [tradingCardId], references: [id], onDelete: Cascade)
  obtainedAt    DateTime    @default(now())
  specialEffect String?

  marketListing MarketListing?
}

model Player {
  id            String   @id @default(cuid())
  minecraftName String   @unique
  hwid          String?
  uuid          String?  @unique
  customSkinUrl String?
  status        String   @default("ACTIVE")
  mcNameCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards TradingCard[]
  bans  Ban[]

  @@index([uuid])
}

model Ban {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  hwid       String?
  reason     String    @db.Text
  bannedBy   String
  bannedAt   DateTime  @default(now())
  isActive   Boolean   @default(true)
  unbannedAt DateTime?
  unbannedBy String?
}

model Edition {
  id              String   @id @default(cuid())
  name            String   @unique
  iconUrl         String?
  bannerUrl       String?
  mobileBannerUrl String?
  description     String?  @db.Text
  showInShop      Boolean  @default(false)
  isPurchasable   Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model VariantProfile {
  id        String            @id @default(cuid())
  name      String            @unique
  iconUrl   String?
  createdAt DateTime          @default(now())
  links     CardVariantLink[]
}

model CardVariantLink {
  id               String         @id @default(cuid())
  motherCardId     String
  motherCard       TradingCard    @relation("MotherCard", fields: [motherCardId], references: [id], onDelete: Cascade)
  variantProfileId String
  variantProfile   VariantProfile @relation(fields: [variantProfileId], references: [id], onDelete: Cascade)
  targetCardId     String
  targetCard       TradingCard    @relation("TargetCard", fields: [targetCardId], references: [id], onDelete: Cascade)

  @@unique([motherCardId, variantProfileId])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model UserBox {
  id      String @id @default(cuid())
  userId  String
  boxType String
  amount  Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, boxType])
}

model ModApplication {
  id            String   @id @default(cuid())
  discordName   String
  minecraftName String?
  platform      String
  experience    String   @db.Text
  motivation    String   @db.Text
  additions     String   @db.Text
  other         String?  @db.Text
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applicantId   String?
  applicant     User?    @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  discordId     String?
  reviewedBy    String?
}

model LauncherShopItem {
  id          String   @id @default(cuid())
  itemId      String   @unique
  name        String
  description String   @db.Text
  price       Int
  currency    String   @default("paracoins")
  imageUrl    String?
  modelUrl    String?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserCosmetic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model BugReport {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  category         String   @default("Crash")
  status           String   @default("OPEN")
  accountName      String?
  profileName      String?
  minecraftVersion String?
  profileType      String?
  graphicsMode     String?
  gpu              String?
  screenResolution String?
  cpu              String?
  ramSystem        String?
  ramAllocated     String?
  osInfo           String?
  jvmArgs          String?  @db.Text
  javaPath         String?
  logs             String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GuildConfig {
  guildId          String   @id
  moduleTickets    Boolean  @default(true)
  moduleWelcome    Boolean  @default(false)
  moduleSecurity   Boolean  @default(false)
  moduleAutoMod    Boolean  @default(false)
  moduleAuditLogs  Boolean  @default(false)
  moduleTempVoice  Boolean  @default(false)
  moduleEconomy    Boolean  @default(false)
  moduleXp         Boolean  @default(false)
  moduleTcg        Boolean  @default(false)
  welcomeChannelId String?
  welcomeTitle     String?
  welcomeDesc      String?  @db.Text
  welcomeColor     String?
  welcomeImage     String?
  updatedAt        DateTime @updatedAt
}

model MarketListing {
  id         String   @id @default(cuid())
  sellerId   String
  userCardId String   @unique
  price      Int
  createdAt  DateTime @default(now())

  seller   User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userCard UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)
}

model Warn {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  reason    String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
}

model BotModule {
  id          String   @id
  name        String
  description String   @db.Text
  category    String   @default("Général")
  commands    String[]
  settings    Json     @default("[]")
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  declaredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotDailyProgress {
  userId       String
  day          String
  messages     Int      @default(0)
  voiceMinutes Int      @default(0)
  claimed      String[] @default([])
  updatedAt    DateTime @default(now())

  @@id([userId, day])
}

model CasinoStat {
  userId     String   @id
  wagered    Int      @default(0)
  won        Int      @default(0)
  biggestWin Int      @default(0)
  games      Int      @default(0)
  updatedAt  DateTime @default(now())
}

model StaffNote {
  id        String   @id @default(cuid())
  targetId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([targetId])
}

model StaffAbsence {
  id        String   @id @default(cuid())
  discordId String
  startDay  String
  endDay    String
  reason    String?  @db.Text
  createdAt DateTime @default(now())
}

model GuildBackup {
  id        String   @id @default(cuid())
  guildId   String
  label     String
  data      Json
  createdBy String
  createdAt DateTime @default(now())
}

model BotSanction {
  id            String       @id @db.VarChar(6)
  guild_id      BigInt
  user_id       BigInt
  mod_id        BigInt
  sanction_type String       @db.VarChar(20)
  duration      String?
  reason        String?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  appealed      Boolean?     @default(false)
  appeals       BotAppeal[]

  @@index([user_id], map: "idx_sanctions_user")
  @@index([guild_id, user_id], map: "idx_sanctions_guild_user")
  @@map("sanctions")
}

model BotAppeal {
  id          String       @id
  sanction_id String?      @db.VarChar(6)
  pseudo_mc   String?
  arguments   String
  status      String?      @default("pending") @db.VarChar(20)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)
  sanction    BotSanction? @relation(fields: [sanction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "appeals_sanction_id_fkey")

  @@index([sanction_id], map: "idx_appeals_sanction_id")
  @@index([status], map: "idx_appeals_status")
  @@map("appeals")
}

model BotTiktokTarget {
  username      String   @id
  channel_id    BigInt
  role_id       BigInt?
  last_video_id String?
  is_live       Boolean? @default(false)

  @@map("tiktok_targets")
}

model SqlxMigration {
  version        BigInt   @id
  description    String
  installed_on   DateTime @default(now()) @db.Timestamptz(6)
  success        Boolean
  checksum       Bytes
  execution_time BigInt

  @@map("_sqlx_migrations")
}

model BotRuntime {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("bot_runtime")
}

model Tournament {
  id         BigInt            @id @default(autoincrement())
  guild_id   BigInt
  name       String
  status     String            @default("running") @db.VarChar(12)
  created_by BigInt
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  matches    TournamentMatch[]

  @@map("tournaments")
}

model TournamentMatch {
  tournament_id BigInt
  round         Int
  position      Int
  p1            String?
  p2            String?
  winner        String?
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade, map: "tournament_matches_tournament_id_fkey")

  @@id([tournament_id, round, position])
  @@map("tournament_matches")
}

model CardTrade {
  id         String    @id @default(cuid())
  fromId     String
  toId       String
  offered    String[]
  requested  String[]
  status     String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([fromId])
  @@index([toId])
}
